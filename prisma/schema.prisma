generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  image        String?
  targetScore  String?              @default("750+")
  examDate     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  aiSessions   AiSession[]
  mistakes     Mistake[]
  discussions  QuestionDiscussion[]
  studyPlan    StudyPlan?
  progress     UserProgress[]
  streak       UserStreak?
  vocabularies UserVocabulary[]
}

model Mistake {
  id         String   @id @default(cuid())
  userId     String
  itemKey    String
  type       String
  testId     String?
  part       String?
  questionId String?
  rawMeta    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  progressKey String
  completed   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, progressKey])
  @@index([userId])
}

model StudyPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  planData  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastStudyDate String?
  historyDays   String?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserVocabulary {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  wordData  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model AiSession {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  sessionData String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model QuestionDiscussion {
  id         String   @id @default(cuid())
  userId     String
  testId     String
  questionId String
  query      String
  response   String
  upvotes    Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([testId, questionId])
  @@index([userId])
}
